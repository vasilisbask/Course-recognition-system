msgid "Απόρριψη εισήγησης"
msgstr "Reject recommendation"

msgid "Ο αριθμός πρωτοκόλλου δεν μπορεί να αλλάξει για αυτή την αίτηση."
msgstr "The protocol number cannot be changed for this request."

msgid "Δεν υπάρχει εκκρεμής εισήγηση καθηγητή για αποδοχή."
msgstr "There is no pending professor recommendation to accept."

msgid "Η εισήγηση του καθηγητή έγινε αποδεκτή."
msgstr "The professor recommendation was accepted."

msgid "Δεν υπάρχει εκκρεμής εισήγηση καθηγητή για απόρριψη."
msgstr "There is no pending professor recommendation to reject."

msgid "Η εισήγηση του καθηγητή απορρίφθηκε και η αίτηση παραμένει υπό εξέταση."
msgstr "The professor recommendation was rejected and the request remains under review."

msgid "Μόνο αιτήσεις που είναι υπό εξέταση μπορούν να σημειωθούν ως μη ενεργές."
msgstr "Only requests that are under review can be marked as inactive."

msgid "Μόνο μη ενεργές αιτήσεις μπορούν να επανέλθουν."
msgstr "Only inactive requests can be restored."

msgid "Η αίτηση επανήλθε σε κατάσταση υπό εξέταση."
msgstr "The request was restored to under review."

msgid "Επαναφορά"
msgstr "Restore"

msgid "Συμπληρώστε course_code και professor_email."
msgstr "Fill in course_code and professor_email."

msgid "Δεν βρέθηκε μάθημα με κωδικό %(code)s."
msgstr "Course with code %(code)s was not found."

msgid "Ο κωδικός %(code)s αντιστοιχεί σε περισσότερα από ένα μαθήματα."
msgstr "Code %(code)s matches more than one course."

msgid "Δεν βρέθηκε καθηγητής με email %(email)s."
msgstr "Professor with email %(email)s was not found."

msgid "Αρχείο CSV"
msgstr "CSV file"

msgid "Το αρχείο πρέπει να είναι CSV."
msgstr "The file must be a CSV file."

msgid "Το αρχείο CSV δεν μπορεί να διαβαστεί. Χρησιμοποιήστε UTF-8."
msgstr "The CSV file cannot be read. Use UTF-8."

msgid "Το CSV δεν περιέχει γραμμές για import."
msgstr "The CSV does not contain rows to import."

msgid "Το CSV πρέπει να έχει επικεφαλίδες."
msgstr "The CSV must contain headers."

msgid "Το CSV πρέπει να έχει στήλες course_code και professor_email."
msgstr "The CSV must contain course_code and professor_email columns."

msgid "Επιλογή αρχείου"
msgstr "Choose file"

msgid "Δεν επιλέχθηκε αρχείο."
msgstr "No file selected."

msgid "Συμπληρώθηκε από χρήστη"
msgstr "Completed by user"

msgid "Ο αριθμός πρωτοκόλλου πρέπει να είναι θετικός ακέραιος αριθμός."
msgstr "The protocol number must be a positive integer."

msgid "Ο αριθμός πρωτοκόλλου πρέπει να είναι μεγαλύτερος από το μηδέν."
msgstr "The protocol number must be greater than zero."

msgid "Αυτός ο αριθμός πρωτοκόλλου χρησιμοποιείται ήδη σε άλλη αίτηση."
msgstr "This protocol number is already used in another request."

msgid "Το import δεν ολοκληρώθηκε. "
msgstr "The import was not completed. "

msgid "Το import ολοκληρώθηκε με σφάλματα. "
msgstr "The import completed with errors. "

msgid "Προστέθηκε 1 ανάθεση."
msgstr "Added 1 assignment."

msgid "Προστέθηκαν %(imported)s αναθέσεις."
msgstr "Added %(imported)s assignments."

msgid "Η τιμή πρέπει να είναι από 1 έως 8."
msgstr "The value must be from 1 to 8."

msgid "Αλλαγή Θέματος"
msgstr "Toggle theme"

msgid "Η αίτηση δεν μπορεί να επεξεργαστεί επειδή έχει ολοκληρωθεί η εισήγηση."
msgstr "This request cannot be edited because the recommendation has been completed."

msgid "Η αίτηση δεν μπορεί να επεξεργαστεί επειδή δεν είναι υπό εξέταση."
msgstr "This request cannot be edited because it is not under review."

msgid "Η αίτηση δεν μπορεί να επεξεργαστεί επειδή υπάρχει εκκρεμής εισήγηση καθηγητή."
msgstr "This request cannot be edited because there is a pending professor recommendation."

msgid "Η αιτιολόγηση διαγραφής είναι υποχρεωτική."
msgstr "The deletion justification is required."

msgid "Η αιτιολόγηση είναι υποχρεωτική."
msgstr "The justification is required."

msgid "Αιτιολόγηση"
msgstr "Justification"

msgid "Αιτιολόγηση διαγραφής"
msgstr "Deletion justification"

msgid "Στοιχεία διαγραφής"
msgstr "Deletion details"

msgid "Διαγραφή από"
msgstr "Deleted by"

msgid "Ημερομηνία διαγραφής"
msgstr "Deletion date"

msgid "Ο βαθμός αναγνώρισης συμπληρώνεται μόνο όταν η εισήγηση εγκρίνεται."
msgstr "The recognition grade can be filled in only when the recommendation is approved."

msgid "Ο αριθμός πρωτοκόλλου δεν μπορεί να αλλάξει επειδή έχει ολοκληρωθεί η εισήγηση."
msgstr "The protocol number cannot be changed because the recommendation has been completed."

msgid "Η τιμή πρέπει να είναι από 0 έως 10."
msgstr "The value must be between 0 and 10."

msgid "Η τιμή πρέπει να είναι από 1 έως 3."
msgstr "The value must be between 1 and 3."

msgid "Η τιμή πρέπει να είναι από 5 έως 10."
msgstr "The value must be between 5 and 10."

msgid "Διαγραφή αίτησης"
msgstr "Delete request"

msgid "Η αίτηση θα σημειωθεί ως μη ενεργή. Είστε σίγουροι;"
msgstr "The request will be marked as inactive. Are you sure?"

msgid "Συμπληρώστε αυτό το πεδίο."
msgstr "Please fill out this field."

msgid "Ο καθηγητής %(professor)s είναι ήδη υπεύθυνος στο μάθημα %(course)s."
msgstr "Professor %(professor)s is already responsible for course %(course)s."

msgid "Πρέπει να επιλεχθεί κάποιο αρχείο."
msgstr "A file must be selected."

